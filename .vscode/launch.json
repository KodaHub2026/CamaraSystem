{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Detector de Emociones",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Detector - modo sensible + malla",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--umbral", "0.16", "--malla", "--espectro"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Detector - grupo (4 rostros)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--rostros", "4"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
